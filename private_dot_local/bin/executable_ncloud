#!/bin/bash
# NCP 공식 CLI 래퍼. 공식 배포본의 래퍼는 상대 경로(./lib/test.jar)를 써서
# 설치 디렉터리 밖에서 실행하면 깨진다. 여기서는 절대 경로로 고정한다.
JAR="$HOME/.local/lib/ncloud-cli/ncloud-cli-1.1.23-gov.jar"
JAVA="${NCLOUD_JAVA:-$(command -v java)}"
[ -n "$JAVA" ] && [ -x "$JAVA" ] || { echo "ncloud: java 를 찾을 수 없습니다." >&2; exit 1; }
[ -f "$JAR" ] || { echo "ncloud: CLI jar 이 없습니다: $JAR" >&2; exit 1; }
exec "$JAVA" -jar "$JAR" "$@"
