#!/usr/bin/env bash
set -euo pipefail

# Temporarily recover the built-in ASUS webcam after suspend/resume by rebinding
# the xHCI PCI controller it hangs from. This will briefly disconnect USB devices
# on the same controller.

WEBCAM_ID="13d3:52b9"
FALLBACK_XHCI="0000:c4:00.4"

log() { printf '[resume-cam] %s\n' "$*"; }

show_status() {
  log "video nodes:"
  ls -l /dev/video* /dev/media* 2>/dev/null || log "no /dev/video* or /dev/media* nodes"
  if command -v wpctl >/dev/null 2>&1; then
    log "pipewire video status:"
    wpctl status 2>/dev/null | sed -n '/Video/,$p' | sed -n '1,80p' || true
  fi
}

find_xhci_for_webcam() {
  local vendor product devpath pci
  vendor="${WEBCAM_ID%:*}"
  product="${WEBCAM_ID#*:}"

  for dev in /sys/bus/usb/devices/*; do
    [[ -r "$dev/idVendor" && -r "$dev/idProduct" ]] || continue
    [[ "$(<"$dev/idVendor")" == "$vendor" && "$(<"$dev/idProduct")" == "$product" ]] || continue

    devpath="$(readlink -f "$dev")"
    pci="$(grep -oE '0000:[0-9a-f]{2}:[0-9a-f]{2}\.[0-7]' <<<"$devpath" | tail -n1 || true)"
    if [[ -n "$pci" && -e "/sys/bus/pci/drivers/xhci_hcd/$pci" ]]; then
      printf '%s\n' "$pci"
      return 0
    fi
  done

  if [[ -e "/sys/bus/pci/drivers/xhci_hcd/$FALLBACK_XHCI" || -e "/sys/bus/pci/devices/$FALLBACK_XHCI" ]]; then
    printf '%s\n' "$FALLBACK_XHCI"
    return 0
  fi

  return 1
}

case "${1:-}" in
  -s|--status)
    show_status
    exit 0
    ;;
  -h|--help)
    cat <<EOF
Usage: resume-cam [--status]

Rebinds the xHCI controller for the built-in ASUS webcam ($WEBCAM_ID), then
restarts the user WirePlumber service so PipeWire rediscovers the camera.
Requires sudo for PCI unbind/bind.
EOF
    exit 0
    ;;
esac

XHCI="$(find_xhci_for_webcam)" || {
  log "could not find webcam controller; fallback $FALLBACK_XHCI not present"
  exit 1
}

log "rebinding xHCI controller $XHCI"
log "sudo may ask for your password"

if [[ -e "/sys/bus/pci/drivers/xhci_hcd/$XHCI" ]]; then
  printf '%s\n' "$XHCI" | sudo tee /sys/bus/pci/drivers/xhci_hcd/unbind >/dev/null
  sleep 2
else
  log "$XHCI is not currently bound to xhci_hcd; trying bind only"
fi

printf '%s\n' "$XHCI" | sudo tee /sys/bus/pci/drivers/xhci_hcd/bind >/dev/null
sleep 2

log "restarting WirePlumber user service"
systemctl --user restart wireplumber.service 2>/dev/null || true
sleep 1

show_status
