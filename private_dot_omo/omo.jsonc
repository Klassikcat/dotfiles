// OMO configuration
{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",
  "[opencode]": {
    "team_mode": {
      "enabled": true,
      "max_parallel_members": 4,
      "tmux_visualization": true,
    },
    "agents": {
      "sisyphus": {
        "model": "zai-coding-plan/glm-5.3",
        "fallback_models": [
          "openrouter/z-ai/glm-5.2",
          "openai/gpt-6-astra",
          "openrouter/deepseek/deepseek-v4-pro",
        ],
      },
      "librarian": {
        "model": "opencode-go/deepseek-v4-flash",
        "fallback_models": [
          "openrouter/minimax/minimax-m2.7",
          "local/gemma4-26b",
        ],
      },
      "prometheus": {
        "model": "opencode-go/kimi-k3",
        "reasoning": "high",
        "fallback_models": [
          "openrouter/anthropic/claude-fable-5",
          "openrouter/z-ai/glm-5.3",
        ],
      },
      "hephaestus": {
        "model": "openai/gpt-6-astra",
        "reasoning": "xhigh",
        "providerOptions": {
          "textVerbosity": "low",
        },
      },
      "metis": {
        "model": "openrouter/anthropic/claude-fable-5",
        "reasoning": "xhigh",
        "providerOptions": {
          "textVerbosity": "low",
        },
      },
      "momus": {
        "model": "openai/gpt-6-astra",
        "reasoning": "high",
        "fallback_models": [
          "openrouter/moonshotai/kimi-k3",
          "openai/gpt-5.6-sol",
        ],
      },
      "oracle": {
        "model": "openai/gpt-5.6-terra",
        "reasoning": "xhigh",
        "providerOptions": {
          "textVerbosity": "low",
        },
      },
      "explore": {
        "model": "openrouter/deepseek/deepseek-v4-flash",
        "fallback_models": [
          "openrouter/minimax/minimax-m2.7",
          "local/gemma4-26b",
        ],
      },
      "frontend-ui-ux-engineer": {
        "model": "opencode-go/kimi-k2.6",
        "fallback_models": ["local/gemma4-26b"],
      },
      "document-writer": {
        "model": "zai-coding-plan/glm-5.3",
        "fallback_models": ["openrouter/deepseek/deepseek-v4-flash"],
      },
      "multimodal-looker": {
        "model": "openrouter/google/gemini-3.5-flash",
      },
      "atlas": {
        "model": "zai-coding-plan/glm-5.3-flash",
        "reasoning": "medium",
        "fallback_models": ["opencode-go/kimi-k3"],
      },
      "sisyphus-junior": {
        "model": "openai/gpt-5.6-luna",
        "reasoning": "medium",
        "fallback_models": [
          "openrouter/openai/gpt-oss-120b",
          "local/gpt-oss-120b",
        ],
      },
    },
    "categories": {
      "visual-engineering": {
        "model": "local/gemma4-26b",
      },
      "ultrabrain": {
        "model": "openai/gpt-5.6-terra",
      },
      "deep": {
        "model": "openai/gpt-5.6-terra",
      },
      "artistry": {
        "model": "local/gemma4-26b",
      },
      "quick": {
        "model": "openai/gpt-5.4-mini",
      },
      "unspecified-low": {
        "model": "openai/gpt-5.4-mini",
      },
      "unspecified-high": {
        "model": "openai/gpt-5.5",
      },
      "writing": {
        "model": "opencode-go/glm-5.2",
      },
    },
  },
  "legacy_migrations": {
    "/home/shinjungtae/.config/opencode/oh-my-openagent.json": [
      "model-version:openai/gpt-5.3-codex->openai/gpt-5.4",
    ],
  },
  "_migrations": [
    "2026-07-opencode-config-unification",
    "2026-08-reasoning-unification",
  ],
}
