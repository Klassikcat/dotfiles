{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "team_mode": {
    "enabled": true,
    "max_parallel_members": 4,
    "tmux_visualization": true
  },
  "agents": {
    "sisyphus": {
      "model": "zai-coding-plan/glm-5.2",
      "fallback_models": [
        "openrouter/z-ai/glm-5.2",
        "opencode-go/kimi-k2.7-code",
        "openrouter/deepseek/deepseek-v4-pro"
      ],
      "textVerbosity": "low"
    },
    "librarian": {
      "model": "opencode-go/deepseek-v4-flash",
      "fallback_models": ["openrouter/minimax/minimax-m2.7", "local/gemma4-26b"]
    },
    "prometheus": {
      "model": "openrouter/anthropic/claude-fable-5",
      "fallback_models": ["opencode-go/kimi-k3", "openrouter/z-ai/glm-5.2"],
      "reasoningEffort": "high",
      "textVerbosity": "low"
    },
    "hephaestus": {
      "model": "openai/gpt-5.5",
      "reasoningEffort": "high",
      "textVerbosity": "low"
    },
    "metis": {
      "model": "openrouter/moonshotai/kimi-k3",
      "reasoningEffort": "xhigh",
      "textVerbosity": "low"
    },
    "momus": {
      "model": "openai/gpt-5.6-terra",
      "fallback_models": [
        "openrouter/moonshotai/kimi-k3",
        "openai/gpt-5.6-sol"
      ],
      "reasoningEffort": "high",
      "textVerbosity": "low"
    },
    "oracle": {
      "model": "openai/gpt-5.6-terra",
      "reasoningEffort": "xhigh",
      "textVerbosity": "low"
    },
    "explore": {
      "model": "openrouter/deepseek/deepseek-v4-flash",
      "fallback_models": ["openrouter/minimax/minimax-m2.7", "local/gemma4-26b"]
    },
    "frontend-ui-ux-engineer": {
      "model": "opencode-go/kimi-k2.6",
      "fallback_models": ["local/gemma4-26b"],
      "textVerbosity": "low"
    },
    "document-writer": {
      "model": "zai-coding-plan/glm-5.2",
      "fallback_models": ["openrouter/deepseek/deepseek-v4-flash"]
    },
    "multimodal-looker": {
      "model": "openrouter/google/gemini-3.5-flash"
    },
    "atlas": {
      "model": "zai-coding-plan/glm-5.2",
      "fallback_models": ["opencode-go/kimi-k3"],
      "variant": "medium",
      "textVerbosity": "low",
      "reasoningEffort": "medium"
    },
    "sisyphus-junior": {
      "model": "openai/gpt-5.6-luna",
      "fallback_models": [
        "openrouter/openai/gpt-oss-120b",
        "local/gpt-oss-120b"
      ],
      "reasoningEffort": "medium",
      "textVerbosity": "low"
    }
  },
  "categories": {
    "visual-engineering": {
      "model": "local/gemma4-26b"
    },
    "ultrabrain": {
      "model": "openai/gpt-5.6-terra"
    },
    "deep": {
      "model": "openai/gpt-5.6-terra"
    },
    "artistry": {
      "model": "local/gemma4-26b"
    },
    "quick": {
      "model": "openai/gpt-5.4-mini"
    },
    "unspecified-low": {
      "model": "openai/gpt-5.4-mini"
    },
    "unspecified-high": {
      "model": "openai/gpt-5.5"
    },
    "writing": {
      "model": "opencode-go/glm-5.2"
    }
  }
}
