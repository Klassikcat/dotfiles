[Unit]
Description=llama.cpp llama-server router — local GGUF models (Vulkan/RADV, gfx1151)
Documentation=https://github.com/ggml-org/llama.cpp
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=exec
# Pin the sibling shared libs of the prebuilt Vulkan build
Environment=LD_LIBRARY_PATH=%h/.local/share/llama.cpp/current
# Strix Halo: flash-attn ON + --no-mmap are required to avoid Vulkan crashes/slowdowns.
# Router mode keeps the stable 127.0.0.1:8080 endpoint and routes by request "model".
# Model-specific paths and sampling live in ~/.config/llama-server-models.ini.
ExecStart=%h/.local/share/llama.cpp/current/llama-server \
  --models-preset %h/.config/llama-server-models.ini \
  --models-max 2 \
  --host 127.0.0.1 --port 8080
Restart=on-failure
RestartSec=10
# llama-server can take a while to load + warm up local GGUF models
TimeoutStartSec=300
StandardOutput=journal
StandardError=journal
SyslogIdentifier=llama-server

[Install]
WantedBy=default.target
